### ============================================
### 1. LOGIN — admin@drivecore.com / 1234
### ============================================
# @name login
POST {{host}}/api/Auth/Login
Content-Type: application/json

{
    "email": "admin@drivecore.com",
    "password": "1234"
}

### --- Manually copy the accessToken and the first branchId from the login response into @token and @branchId at the top of this file ---

### ============================================
### 2. CREATE CATEGORY
### ============================================
# @name createCategory
POST {{host}}/api/Category
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Ropa",
    "description": "Prendas de vestir en general"
}

### --- Manually copy the category id from the response ---
@categoryId = 019f5d7a-3e3a-773d-9780-5dba475bd947

### ============================================
### 3. CREATE BRAND
### ============================================
# @name createBrand
POST {{host}}/api/Brand
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Nike",
    "prefix": "NKE",
    "description": "Marca deportiva"
}

### --- Manually copy the brand id from the response ---
@brandId = 019f5d7a-c1af-75a2-824a-25c455127145

### ============================================
### 4. CREATE COLOR
### ============================================
# @name createColor
POST {{host}}/api/Color
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Rojo"
}

### --- Manually copy the color id from the response ---
@colorId = 019f5d7b-21f1-7fd5-8727-149a37896ee9

### ============================================
### 5. CREATE PRODUCT (with variants)
### ============================================
# @name createProduct
POST {{host}}/api/Product
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Camiseta Deportiva",
    "description": "Camiseta deportiva de algodón",
    "categoryId": "{{categoryId}}",
    "brandId": "{{brandId}}",
    "gender": 0,
    "unitMeasurementSin": 1,
    "economicActivity": "471001",
    "productCodeSin": 12345,
    "variants": [
        {
            "colorId": "{{colorId}}",
            "size": "M",
            "price": 150.00,
            "description": "Mediana roja"
        },
        {
            "colorId": "{{colorId}}",
            "size": "L",
            "price": 180.00,
            "description": "Grande roja"
        }
    ]
}

### --- Manually copy the variant IDs from the response ---
@variant1Id = 019f5d7b-7065-71c9-8987-d00d16d8761f
@variant2Id = 019f5d7b-7078-7461-83e6-442ee87edae6

### ============================================
### 6. OPEN CASH REGISTER
### ============================================
# @name openCashRegister
POST {{host}}/api/CashRegister/Open
Authorization: Bearer {{token}}
Content-Type: application/json
X-BRANCH-ID: {{branchId}}

{
    "branchId": "{{branchId}}",
    "openingBalance": 500.00
}

### --- Manually copy the cash closure id from the response ---
@cashClosureId = f61cd6ce-5a55-4fa7-b5af-aa0cd31d8658

### ============================================
### 7. CREATE RECEPTION (stock for variant 1 only)
### ============================================
# @name createReception
POST {{host}}/api/Reception
Authorization: Bearer {{token}}
X-BRANCH-ID: {{branchId}}
Content-Type: application/json

{
    "notes": "Recepción inicial de inventario",
    "items": [
        {
            "productVariantId": "{{variant1Id}}",
            "quantityReceived": 50,
            "unitCost": 80.00
        }
    ]
}

### ============================================
### 8. CREATE SALE (sell variant 1 — should succeed)
### ============================================
POST {{host}}/api/Sale
Authorization: Bearer {{token}}
X-BRANCH-ID: {{branchId}}
Content-Type: application/json

{
    "paymentMethod": 0,
    "documentType": 0,
    "cashRegisterClosureId": "{{cashClosureId}}",
    "transactionCode": null,
    "notes": "Venta de prueba",
    "items": [
        {
            "productVariantId": "{{variant1Id}}",
            "quantity": 2,
            "discountAmount": 0
        }
    ]
}

